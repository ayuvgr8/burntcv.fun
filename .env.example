# ── Core ─────────────────────────────────────────────────────────────
# Platform Claude API key — powers free & Pro roasts (server-side only).
# Without this, the app steers users to bring their own key (BYOK).
# Used directly UNLESS AI_GATEWAY_API_KEY is set (then it's the fallback path).
ANTHROPIC_API_KEY=sk-ant-api03-...

# Vercel AI Gateway key (optional but recommended). When set, platform roast
# calls route through the gateway's Anthropic-compatible endpoint for per-request
# cost/latency/spend dashboards + provider failover, at zero token markup.
# Get it: Vercel dashboard → project → AI Gateway → API keys. Then set a budget.
# AI_GATEWAY_API_KEY=vck_...
# Gateway model slug is provider-prefixed with dots. Default: anthropic/claude-sonnet-4.6
# GATEWAY_ROAST_MODEL=anthropic/claude-sonnet-4.6

# Public site URL — used for OG/Twitter share images, sitemap, robots.
# Set to your production domain.
NEXT_PUBLIC_SITE_URL=https://burntcv.fun

# ── Optional tuning ──────────────────────────────────────────────────
# Override the roast model. Default: claude-sonnet-4-6
# ROAST_MODEL=claude-sonnet-4-6

# Free roasts per IP per day (rate limit). Default 5.
# FREE_ROASTS_PER_DAY=5

# ── Rate limiting (tiered, per endpoint type) ────────────────────────
# Every threshold below is optional — the app ships with sane defaults. Windows
# are "<n> <unit>" where unit ∈ ms|s|m|h|d (e.g. "1 h", "30 s"). Durable +
# distributed when Upstash Redis is configured (below); best-effort in-memory
# otherwise. All limiters fail OPEN on a Redis error so an outage never 500s.
#
# AUTH tier — STRICT. Account-recovery routes (restore code, magic-link/-claim,
# Creem claim). Combines a per-IP window AND a per-account window, plus
# exponential backoff on repeated failures (a growing cooldown, NOT a hard
# lockout — one success clears it).
# RL_AUTH_IP_MAX=20            # attempts per IP per window (alias: RESTORE_PER_HOUR)
# RL_AUTH_IP_WINDOW=1 h
# RL_AUTH_ACCOUNT_MAX=5        # attempts per account (code/email/id) per window
# RL_AUTH_ACCOUNT_WINDOW=1 h
# RL_AUTH_BACKOFF_THRESHOLD=3  # consecutive failures before backoff starts
# RL_AUTH_BACKOFF_BASE_MS=1000 # first backoff step; doubles each further failure
# RL_AUTH_BACKOFF_MAX_MS=900000    # cap on a single cooldown (15 min)
# RL_AUTH_BACKOFF_TTL_MS=3600000   # how long failure state is remembered (1 h)
#
# PUBLIC tier — MODERATE. Unauthenticated endpoints (extract, payment/order,
# payment/verify, creem/checkout, geo, stats). Per-IP burst ceiling.
# RL_PUBLIC_MAX=30
# RL_PUBLIC_WINDOW=1 m
#
# USER tier — LOOSE. Authenticated (Pass-holder) roast/glow-up burst ceiling —
# never trips for a human; stops a leaked Pass code being scripted.
# RL_USER_MAX=120
# RL_USER_WINDOW=1 m
#
# Feedback form submissions per IP per hour. Default 5.
# FEEDBACK_PER_HOUR=5

# Global daily spend cap (USD) on the platform Claude key — the catastrophe
# backstop above per-IP limits: caps TOTAL platform spend per UTC day so an
# IP-rotating abuser or a viral spike can't run up an unbounded Anthropic bill.
# When the day's budget is spent, free/single/top-up roasts steer to BYOK until
# the window rolls over; verified Pass holders are never blocked. Best-effort
# without Upstash Redis (durable + distributed with it). Default 10. Set 0 to
# disable the cap entirely.
# PLATFORM_DAILY_BUDGET_USD=10

# Upstream request timeout in ms. Default 45000.
# ROAST_TIMEOUT_MS=45000

# ── Payments (Razorpay) — go live with ₹7 / ₹5 / ₹49 / ₹199 charges ──
# Without these, the pay-to-roast flow runs in SIMULATED mode (unlocks
# instantly, no real charge). Add both to charge for real.
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxx   # client — enables real checkout
# RAZORPAY_KEY_SECRET=xxxxxxxx                     # server — signs & verifies orders
# Webhook (reliability net): set the SAME secret in Razorpay → Webhooks, and
# point the webhook at https://<domain>/api/payment/webhook (event: payment.captured).
# RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxx

# ── Payments (Creem) — international checkout, Merchant of Record ─────
# India is served by Razorpay (above); everyone else checks out via Creem,
# which acts as Merchant of Record (handles global cards + sales tax/VAT).
# THREE one-time products are sold internationally (all above the $4.99 friction
# floor — no sub-$1 micro-charges, fees eat them):
#   • $9.99 6-Month Pass   (400 roasts / 6 months + 4 included Glow-Ups)
#   • $4.99 Glow-Up        (a non-Pass user's one-off rewrite)
#   • $3.99 Glow-Up top-up (a Pass holder's 5th+ Glow-Up, cheaper loyalty price)
# Which product a checkout paid for is verified server-side by its product id, so
# a $4.99/$3.99 Glow-Up can't be redeemed as a $9.99 Pass. Without these, the Creem
# cards run in SIMULATED mode. The key prefix routes the environment: creem_test_…
# → test API, creem_live_… → live API. Create all three products + get the
# key/secret in the Creem dashboard.
# CREEM_API_KEY=creem_live_xxxxxxxx              # server — creates & verifies checkouts
# CREEM_PRODUCT_ID=prod_xxxxxxxx                 # the one-time $9.99 6-Month Pass product
# CREEM_GLOWUP_PRODUCT_ID=prod_xxxxxxxx          # the one-time $4.99 Glow-Up product
# CREEM_GLOWUP_TOPUP_PRODUCT_ID=prod_xxxxxxxx    # the one-time $3.99 Glow-Up top-up product
# Webhook (reliability net): set this to the webhook signing secret and point
# Creem → Webhooks at https://<domain>/api/creem/webhook (event: checkout.completed).
# CREEM_WEBHOOK_SECRET=whsec_xxxxxxxx

# ── Live job openings (the Glow-Up's "SEND IT HERE" section) ─────────
# Attaches real, recently-posted openings to a paid Glow-Up. Entirely optional:
# with none of these set the section is simply absent — the Glow-Up itself is
# unaffected. Full design + the live testing behind it: docs/jobs-feed-spec.md
#
# Kill switch. Set to "false" to hide the section without removing any keys.
# JOBS_ENABLED=true
#
# DISCOVERY — at least one is required for the section to appear at all.
# JSearch (Google for Jobs, via RapidAPI) is primary: much the best Indian
# coverage. Free tier is 200 requests/MONTH and hard-blocks at the limit, so
# watch it — one busy day can spend the month. rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# JSEARCH_RAPIDAPI_KEY=xxxxxxxx
# JSEARCH_RAPIDAPI_HOST=jsearch.p.rapidapi.com
# Adzuna is the fallback — cleaner index, weaker in India. Free 1,000 calls/month.
# Register at developer.adzuna.com
# ADZUNA_APP_ID=xxxxxxxx
# ADZUNA_APP_KEY=xxxxxxxx
#
# VERIFICATION — optional. Powers the "live as of <time>" check when a user
# expands a job card. Without it cards read "couldn't confirm", which is honest
# and costs nothing. Free tier is 1,000 credits/month; we spend 1 per check and
# only check cards a user actually opens. firecrawl.dev
# NOTE: Firecrawl refuses LinkedIn/Indeed/Glassdoor outright, so those postings
# are permanently unverifiable and the UI says so rather than implying a check.
# FIRECRAWL_API_KEY=fc-xxxxxxxx
#
# Monthly caps — the backstop for all three. Deliberately set BELOW each vendor's
# true free limit so we degrade to a labelled empty state on our own terms rather
# than on a vendor 429. These FAIL CLOSED: with Redis unreachable in production
# the feature turns itself off rather than risk burning a month's allowance.
# JSEARCH_MONTHLY_CAP=180
# ADZUNA_MONTHLY_CAP=900
# FIRECRAWL_MONTHLY_CAP=900
#
# Model for the two support calls (search-term extraction + ranking). Haiku by
# design — both are structured work over parsed data, not prose the user reads.
# JOBS_MODEL=claude-haiku-4-5-20251001
# JOBS_DEFAULT_COUNTRY=in        # ISO-2, used when the résumé shows no location
# JSearch measures 7-11s per call (it fans out across Google for Jobs), so this
# ceiling is deliberately generous. Don't drop it below ~15s.
# JOBS_TIMEOUT_MS=20000
# FIRECRAWL_TIMEOUT_MS=12000

# ── Entitlements + durable rate limiting (Upstash Redis) ─────────────
# REQUIRED for the 6-Month Pass to survive browser-clear / device-switch
# (the Pass is stored here, keyed by restore code + paid email). Also makes
# the per-IP rate limit durable + distributed. Without it, both fall back to
# a best-effort in-process store. Create a free DB at upstash.com.
# UPSTASH_REDIS_REST_URL=https://....upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# Secret used to sign Pass tokens. Defaults to RAZORPAY_KEY_SECRET if unset.
# ENTITLEMENT_SECRET=a-long-random-string
